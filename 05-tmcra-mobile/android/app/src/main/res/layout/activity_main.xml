<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tmcra_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:text="TMCRA / AUDIO MEMORY"
            android:textColor="@color/tmcra_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="把听见的事情，接到下一刻。"
            android:textColor="@color/tmcra_ink"
            android:textSize="30sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="手机本地完成录音分段、离线转写与说话人识别；远端使用文字及本地说话人代号完成 TMCRA 召回与写入。"
            android:textColor="@color/tmcra_muted"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/login_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="登录 TMCRA"
                android:textColor="@color/tmcra_ink"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/email_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/input_background"
                android:hint="邮箱"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="@color/tmcra_ink"
                android:textColorHint="@color/tmcra_muted" />

            <EditText
                android:id="@+id/password_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/input_background"
                android:hint="密码"
                android:inputType="textPassword"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="@color/tmcra_ink"
                android:textColorHint="@color/tmcra_muted" />

            <Button
                android:id="@+id/login_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/tmcra_ink"
                android:text="登录"
                android:textAllCaps="false"
                android:textColor="@color/tmcra_surface" />

            <TextView
                android:id="@+id/login_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/tmcra_warning"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dashboard_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/account_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/tmcra_ink"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/account_scope"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/tmcra_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/logout_button"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:backgroundTint="@color/tmcra_line"
                    android:text="退出"
                    android:textAllCaps="false"
                    android:textColor="@color/tmcra_ink" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/capture_background"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:id="@+id/capture_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="尚未开始采集"
                    android:textColor="@color/tmcra_surface"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/capture_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="点击后，Android 会显示持续录音通知。静音段不会写入。"
                    android:textColor="#C9D1CB"
                    android:textSize="14sp" />

                <ProgressBar
                    android:id="@+id/audio_level"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="18dp"
                    android:max="100"
                    android:progress="0"
                    android:progressBackgroundTint="#34423A"
                    android:progressTint="@color/tmcra_signal" />

                <Button
                    android:id="@+id/capture_button"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="@color/tmcra_surface"
                    android:text="开始音频记忆"
                    android:textAllCaps="false"
                    android:textColor="@color/tmcra_ink" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="当前处理链路"
                    android:textColor="@color/tmcra_ink"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/pipeline_stage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="等待有效语音"
                    android:textColor="@color/tmcra_signal"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/partial_transcript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="本地实时草稿会显示在这里"
                    android:textColor="@color/tmcra_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/stable_transcript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="最终文本尚未确定"
                    android:textColor="@color/tmcra_ink"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/recall_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="召回：尚未开始"
                    android:textColor="@color/tmcra_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/delivery_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="提醒：尚未触发"
                    android:textColor="@color/tmcra_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/remote_fallback_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:checked="false"
                android:paddingVertical="8dp"
                android:text="使用 Qwen3-ASR 远端高精度复核（默认关闭）"
                android:textColor="@color/tmcra_ink"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="开启后，每个有效语音片段会临时上传到 TMCRA 的 Qwen3-ASR 服务，与本地草稿进行校验。声纹向量始终只留在手机。数字、时间或已确认姓名发生冲突时，系统会暂停写入，等你确认。远端音频只用于转写，不进入记忆索引。"
                android:textColor="@color/tmcra_muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="sans-serif-medium"
                android:text="本机声纹库"
                android:textColor="@color/tmcra_ink"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="新声音会自动建立临时声纹。你可以标记本人、命名或删除；模板不会上传。"
                android:textColor="@color/tmcra_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/speaker_profiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="sans-serif-medium"
                android:text="最近捕获"
                android:textColor="@color/tmcra_ink"
                android:textSize="20sp" />

            <LinearLayout
                android:id="@+id/recent_segments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
