# Copy to /opt/tmcra-release/shared/api-tunnel.env on the website VM.
# Set these for an optional loopback SSH tunnel to a separately deployed API.
# The SSH key and known-hosts file must be owned by the `tmcra` system user.
TMCRA_API_SSH_HOST=memory-api.example.invalid
TMCRA_API_SSH_PORT=22
TMCRA_API_SSH_USER=tmcra
TMCRA_API_SSH_KEY_PATH=/etc/tmcra/ssh/api-tunnel
TMCRA_API_SSH_KNOWN_HOSTS_PATH=/etc/tmcra/ssh/api-known-hosts
