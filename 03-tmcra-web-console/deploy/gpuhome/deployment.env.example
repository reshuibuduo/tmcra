# Copy to /opt/tmcra/tmcra-official/shared/deployment.env and replace every blank secret.
TMCRA_PROJECT_ROOT=/opt/tmcra/tmcra-official/current
TMCRA_NODE_BIN=/opt/tmcra/.local/node-v24.18.0/bin/node
TMCRA_LOG_DIR=/opt/tmcra/tmcra-official/shared/logs
TMCRA_DOWNLOAD_ROOT=/opt/tmcra/tmcra-official/shared/downloads
TMCRA_UPSTREAM_HOST=127.0.0.1
TMCRA_UPSTREAM_PORT=2001
TMCRA_PUBLIC_PORT=2000
TMCRA_PUBLIC_HOSTS=tmcra.com,www.tmcra.com,tmcra.com:9443,www.tmcra.com:9443,euvbyqa1jpvdm7yq-2000.sc01-webservice.gpuhome.cc:8443
TMCRA_PUBLIC_BASE_URL=https://tmcra.com

# Internal control plane. Access fails closed with a 404 when the allowlist is
# empty. Use the operator's non-VPN public IP as a /32 (or /128 for IPv6).
# Multiple exact IPs or CIDRs may be comma-separated.
TMCRA_INTERNAL_ALLOWED_IPS=
# Only these direct peers may provide X-TMCRA-Client-IP. The production Nginx
# proxy is local, so the loopback-only default should normally remain unchanged.
TMCRA_TRUSTED_PROXY_IPS=127.0.0.1/32,::1/128
TMCRA_INTERNAL_BOOTSTRAP_OWNER_EMAIL=

# Native customer accounts. Generate the session secret with:
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
TMCRA_ACCOUNT_DATABASE=/opt/tmcra/tmcra-official/shared/auth/accounts.sqlite3
TMCRA_SESSION_SECRET=
TMCRA_PASSWORD_ITERATIONS=600000
TMCRA_SESSION_IDLE_SECONDS=43200
TMCRA_SESSION_ABSOLUTE_SECONDS=604800
TMCRA_SESSION_ROTATE_SECONDS=3600

# Automated account email. Use a transactional provider, not an employee mailbox.
# Resend example: host=smtp.resend.com, port=465, security=smtps,
# username=resend, password=the server-only Resend API key.
TMCRA_MAIL_TRANSPORT=smtp
TMCRA_MAIL_FROM_EMAIL=no-reply@auth.tmcra.com
TMCRA_MAIL_FROM_NAME=TMCRA
# Set only after the human support mailbox exists and can receive replies.
TMCRA_MAIL_REPLY_TO=
TMCRA_SMTP_HOST=
TMCRA_SMTP_PORT=465
TMCRA_SMTP_SECURITY=smtps
TMCRA_SMTP_USERNAME=
TMCRA_SMTP_PASSWORD=
TMCRA_SMTP_TIMEOUT_SECONDS=15
TMCRA_EMAIL_TOKEN_SECONDS=600
TMCRA_PASSWORD_RESET_SECONDS=1800

# Promotional email is deliberately isolated from account email. Use a second
# domain-scoped, sending-only provider credential. Campaign requests are queued
# and may only target verified users who explicitly opted in.
TMCRA_MARKETING_ENABLED=false
TMCRA_MARKETING_MAIL_TRANSPORT=disabled
TMCRA_MARKETING_MAIL_FROM_EMAIL=updates@auth.tmcra.com
TMCRA_MARKETING_MAIL_FROM_NAME=TMCRA
TMCRA_MARKETING_MAIL_REPLY_TO=
TMCRA_MARKETING_SMTP_HOST=
TMCRA_MARKETING_SMTP_PORT=465
TMCRA_MARKETING_SMTP_SECURITY=smtps
TMCRA_MARKETING_SMTP_USERNAME=
TMCRA_MARKETING_SMTP_PASSWORD=
TMCRA_MARKETING_SMTP_TIMEOUT_SECONDS=15
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
TMCRA_MARKETING_API_TOKEN=
TMCRA_MARKETING_SEND_INTERVAL_SECONDS=0.25
TMCRA_MARKETING_MAX_ATTEMPTS=3

# Optional Google OpenID Connect login. The redirect URI registered in Google
# Cloud must be exactly https://tmcra.com/oauth/google/callback.
TMCRA_GOOGLE_CLIENT_ID=
TMCRA_GOOGLE_CLIENT_SECRET=
TMCRA_GOOGLE_REDIRECT_URI=https://tmcra.com/oauth/google/callback

# Server-only TMCRA Memory control credentials used by the vinext BFF.
TMCRA_MEMORY_API_BASE_URL=
# GPUHome only: keep the client-facing URL above public HTTPS, while the BFF
# reaches the co-located API without depending on public-port hairpin routing.
TMCRA_MEMORY_API_CONTROL_BASE_URL=http://127.0.0.1:2009
TMCRA_MEMORY_API_CONTROL_ALLOW_HTTP_LOOPBACK=1
TMCRA_MEMORY_API_CONTROL_KEY=
# Read-only staff telemetry credential. This must match
# TMCRA_SERVICE_STAFF_MONITORING_KEY on the Memory API host.
TMCRA_MEMORY_API_STAFF_MONITORING_KEY=
TMCRA_DEVICE_TOKEN_ENCRYPTION_KEY=
TMCRA_DEVICE_FLOW_HASH_KEY=
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
TMCRA_DEVICE_MAINTENANCE_SECRET=
TMCRA_DEVICE_MAINTENANCE_INTERVAL_SECONDS=30
