# Copy this file to /etc/tmcra/writer.env, chmod it to 0600, and replace every
# placeholder. Never commit the live file. The service derives the complete
# Writer, reviewer, recall-planner, and slow-graph routes from this boundary.

# Default production route: self-hosted Qwen3.6-35B-A3B (35B total parameters,
# about 3B active parameters per token) handles Writer, Reviewer, recall planner,
# and slow graph through separate prompt adapters.
TMCRA_DEEPSEEK_WRITER_BASE_URL=https://api.deepseek.com/v1
TMCRA_DEEPSEEK_WRITER_KEY_POOL=local-route-disabled
TMCRA_DEEPSEEK_WRITER_KEY_POOL_COUNT=1
TMCRA_WRITER_PROVIDER=local-qwen
TMCRA_WRITER_MAX_TOKENS=16384

TMCRA_RECALL_PLANNER_PROVIDER=local-qwen
TMCRA_RECALL_PLANNER_MAX_TOKENS=512
TMCRA_RECALL_PLANNER_TIMEOUT_SECONDS=60

TMCRA_WRITER_REVIEWER_PROVIDER=local-qwen
TMCRA_SLOW_GRAPH_PROVIDER=local-qwen

TMCRA_LOCAL_WRITER_BASE_URL=http://127.0.0.1:11435/v1
TMCRA_LOCAL_WRITER_MODEL=tmcra-qwen3.6-35b-a3b-iq3s
TMCRA_LOCAL_WRITER_API_KEY_FILE=/opt/tmcra-data/local-llm/secrets/qwen36-api.key
TMCRA_WRITER_PROMPT_ADAPTER=qwen36-v5
TMCRA_RECALL_PLANNER_PROMPT_ADAPTER=qwen36-planner-v1
TMCRA_WRITER_REVIEWER_PROMPT_ADAPTER=qwen36-reconciliation-v1
TMCRA_SLOW_GRAPH_PROMPT_ADAPTER=qwen36-slow-graph-v1

# Optional DeepSeek provider route. Uncomment these settings, supply an
# operator-owned key, and replace the four provider selections above.
# TMCRA_DEEPSEEK_WRITER_KEY_POOL=replace-with-provider-key
# TMCRA_WRITER_PROVIDER=deepseek
# TMCRA_RECALL_PLANNER_PROVIDER=deepseek
# TMCRA_WRITER_REVIEWER_PROVIDER=deepseek
# TMCRA_SLOW_GRAPH_PROVIDER=deepseek
