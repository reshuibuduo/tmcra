TMCRA_SERVICE_PUBLIC_BASE_URL=https://example.invalid
# Public HTTPS is terminated by your trusted TLS reverse proxy.
TMCRA_SERVICE_BIND_HOST=0.0.0.0
TMCRA_SERVICE_BIND_PORT=2009
TMCRA_SERVICE_TLS_PROXY_MODE=trusted_proxy
TMCRA_SERVICE_STATE_DIR=/opt/tmcra/tmcra_service_state
TMCRA_SERVICE_CONTROL_DB=/opt/tmcra/tmcra_service_state/control.sqlite3
TMCRA_V4_ROOT=/opt/tmcra
TMCRA_INTEGRATED_REPO=/opt/tmcra
TMCRA_WRITER_ENV=/etc/tmcra/writer.env
TMCRA_DEEPSEEK_WRITER_BASE_URL=https://api.deepseek.com/v1
TMCRA_NODE_MODEL=/opt/tmcra/path/to/node_scorer.pt
TMCRA_PATH_MODEL=/opt/tmcra/path/to/path_scorer.pt
TMCRA_NODE_MODEL_PATH=/opt/tmcra/path/to/node_scorer.pt
TMCRA_PATH_MODEL_PATH=/opt/tmcra/path/to/path_scorer.pt
TMCRA_CHECKPOINT=/opt/tmcra/models/tmcra_v3_reranker.pt
TMCRA_LEARNED_GRAPH_ENABLED=0
TMCRA_SERVICE_DEVICE=cuda
TMCRA_SERVICE_GRAPH_DEVICE=cuda
TMCRA_PROVIDER_KEY_CONCURRENCY=2
TMCRA_PROVIDER_LEASE_SECONDS=300
TMCRA_SERVICE_REQUEST_MAX_CONCURRENCY=8
TMCRA_SERVICE_REQUESTS_PER_MINUTE=240
TMCRA_SERVICE_REQUEST_LEASE_SECONDS=600
TMCRA_SERVICE_TENANT_QUEUE_LIMIT=100
TMCRA_SERVICE_GLOBAL_QUEUE_LIMIT=1000
TMCRA_SERVICE_WORKER_CONCURRENCY=4
TMCRA_SERVICE_SLOW_DIRTY_TOKEN_THRESHOLD=32000
TMCRA_SERVICE_SLOW_DIRTY_USER_TURN_THRESHOLD=64
TMCRA_SERVICE_SLOW_MAX_AGE_SECONDS=86400
TMCRA_SERVICE_SLOW_MIN_TOKEN_THRESHOLD=4000
TMCRA_SERVICE_SLOW_MIN_USER_TURN_THRESHOLD=8
TMCRA_SERVICE_SLOW_MIN_INTERVAL_SECONDS=1800
TMCRA_SERVICE_INDEX_DIRTY_THRESHOLD=16
TMCRA_SERVICE_INDEX_MAX_AGE_SECONDS=2
TMCRA_SERVICE_SCHEDULER_INTERVAL_SECONDS=1
TMCRA_SERVICE_PRELOAD_ONLINE_ENGINE=1
